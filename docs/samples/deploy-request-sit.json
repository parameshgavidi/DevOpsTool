{
  "application": "GSSWeb",
  "environment": "SIT",
  "action": "deploy",
  "releaseBundle": "GSSWeb-{{BUILD_NUMBER}}",
  "deployManifest": "deploy-manifest-gssweb.json",
  "artifactVersion": "{{BUILD_NUMBER}}",
  "components": [
    {
      "name": "gssweb-iis",
      "type": "iis",
      "artifact": "gssweb-iis.zip"
    }
  ],
  "changeRequestRequired": false,
  "notes": "Same zip Jenkins CI published. Ansible copies it into SIT IIS like the old GSSWebIIS job did on localhost."
}
